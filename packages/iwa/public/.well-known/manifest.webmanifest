{
  "id": "/",
  "name": "LVCE Remote SSH Experiment",
  "short_name": "Remote SSH",
  "version": "0.0.1",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "isolated_storage": true,
  "icons": [
    {
      "src": "/icon.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-private": ["self"],
    "local-network": ["self"],
    "loopback-network": ["self"]
  }
}
