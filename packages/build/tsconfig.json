{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["esnext"],
    "target": "esnext",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "composite": true
  },
  "include": ["src"]
}
