{
  "name": "builtin.remote-ssh",
  "version": "0.0.0-dev",
  "description": "Remote SSH extension for Lvce Editor",
  "main": "dist/remoteSshMain.js",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "type": "module",
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "devDependencies": {
    "@lvce-editor/api": "^9.28.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
