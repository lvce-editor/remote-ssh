{
  "id": "builtin.remote-ssh",
  "name": "Remote SSH",
  "description": "Open folders on SSH hosts",
  "repository": "https://github.com/lvce-editor/remote-ssh",
  "browser": "dist/remoteSshMain.js",
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "isolated": true,
  "compatibility": {
    "web": false
  },
  "rpc": [
    {
      "id": "builtin.remote-ssh.node",
      "type": "node-process",
      "name": "Remote SSH",
      "url": "dist/remoteSshProcess.js"
    }
  ],
  "categories": ["Other"],
  "activation": [
    "onCommand:remote-ssh.connect",
    "onCommand:remote-ssh.getWebSocketUrl",
    "onFileSystem:remote-ssh"
  ],
  "commands": [
    {
      "id": "remote-ssh.connect",
      "label": "SSH: Connect"
    },
    {
      "id": "remote-ssh.getWebSocketUrl",
      "internal": true
    }
  ],
  "fileSystemProviders": [
    {
      "id": "remote-ssh"
    }
  ]
}
