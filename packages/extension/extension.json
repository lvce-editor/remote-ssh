{
  "id": "builtin.remote-ssh",
  "name": "Remote SSH",
  "description": "Open folders on SSH hosts",
  "repository": "https://github.com/lvce-editor/remote-ssh",
  "browser": "dist/remoteSshMain.js",
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "connect-src https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
  ],
  "isolated": true,
  "compatibility": {
    "web": true
  },
  "rpc": [
    {
      "id": "builtin.remote-ssh.node",
      "type": "node-process",
      "name": "Remote SSH",
      "url": "dist/remoteSshProcess.js"
    }
  ],
  "categories": ["Other"],
  "activation": [
    "onCommand:remote-ssh.connect",
    "onCommand:remote-server.connect",
    "onFileSystem:remote-ssh",
    "onFileSystem:remote-server"
  ],
  "commands": [
    {
      "id": "remote-ssh.connect",
      "label": "SSH: Connect"
    },
    {
      "id": "remote-server.connect",
      "label": "Remote Server: Connect with Pairing URL"
    }
  ],
  "fileSystemProviders": [
    {
      "id": "remote-ssh"
    },
    {
      "id": "remote-server"
    }
  ]
}
