{
  "id": "builtin.remote-ssh",
  "name": "Remote SSH",
  "description": "Open folders on SSH hosts",
  "repository": "https://github.com/lvce-editor/remote-ssh",
  "browser": "dist/remoteSshMain.js",
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
  ],
  "isolated": true,
  "compatibility": {
    "web": false
  },
  "rpc": [
    {
      "id": "builtin.remote-ssh.node",
      "type": "node-process",
      "name": "Remote SSH",
      "url": "dist/remoteSshProcess.js"
    }
  ],
  "categories": ["Other"],
  "activation": [
    "onCommand:remote-ssh.connect",
    "onCommand:remote-ssh.connectToProcess",
    "onFileSystem:remote-ssh",
    "onCommand:remote-ssh.request"
  ],
  "commands": [
    {
      "id": "remote-ssh.connect",
      "label": "SSH: Connect"
    },
    {
      "id": "remote-ssh.connectToProcess",
      "internal": true
    },
    {
      "id": "remote-ssh.request",
      "internal": true
    }
  ],
  "fileSystemProviders": [
    {
      "id": "remote-ssh"
    }
  ],
  "workspaceTransport": {
    "scheme": "remote-ssh",
    "command": "remote-ssh.connectToProcess",
    "requestCommand": "remote-ssh.request"
  }
}
