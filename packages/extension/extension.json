{
  "id": "builtin.remote-ssh",
  "name": "Remote SSH",
  "description": "Open folders on SSH hosts",
  "repository": "https://github.com/lvce-editor/remote-ssh",
  "browser": "dist/remoteSshMain.js",
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "isolated": true,
  "compatibility": {
    "web": false
  },
  "rpc": [
    {
      "id": "builtin.remote-ssh.node",
      "type": "node",
      "name": "Remote SSH",
      "url": "dist/remoteSshClient.js"
    }
  ],
  "categories": ["Other"],
  "activation": ["onCommand:remote-ssh.connect", "onFileSystem:remote-ssh"],
  "commands": [
    {
      "id": "remote-ssh.connect",
      "label": "SSH: Connect"
    }
  ],
  "fileSystemProviders": [
    {
      "id": "remote-ssh"
    }
  ]
}
