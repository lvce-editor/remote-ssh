{
  "compilerOptions": {
    "lib": ["esnext", "WebWorker"],
    "target": "esnext",
    "types": [],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "composite": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true
  },
  "include": ["src", "test"]
}
