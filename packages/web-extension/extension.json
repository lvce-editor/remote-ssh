{
  "id": "builtin.remote-server",
  "name": "Remote Server",
  "description": "Open an authenticated remote workspace from the web editor",
  "repository": "https://github.com/lvce-editor/remote-ssh",
  "browser": "dist/remoteServerMain.js",
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "connect-src https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
  ],
  "isolated": true,
  "preserveRuntimeOnWorkspaceChange": true,
  "compatibility": {
    "web": true
  },
  "categories": ["Other"],
  "activation": [
    "onCommand:remote-server.connect",
    "onCommand:remote-server.getWebSocketUrl",
    "onFileSystem:remote-server",
    "onCommand:remote-server.disconnect",
    "onCommand:remote-server.status",
    "onCommand:remote-server.connectToProcess",
    "onCommand:remote-server.request",
    "onCommand:remote-server.releaseWorkspace",
    "onCommand:remote-server.cloudflare",
    "onCommand:remote-server.prepareWorkspace",
    "onCommand:remote-server.benchmark",
    "onCommand:remote-server.connectAccount",
    "onCommand:remote-server.disconnectAccount",
    "onCommand:remote-server.getMachines",
    "onCommand:remote-server.authorizeBrowser",
    "onCommand:remote-server.accountWillChange",
    "onCommand:remote-server.accountDidChange",
    "onCommand:remote-server.reopenInContainer",
    "onCommand:remote-server.reopenOnHost"
  ],
  "commands": [
    {
      "id": "remote-server.connect",
      "label": "Remote Server: Connect with Pairing URL"
    },
    {
      "id": "remote-server.getWebSocketUrl",
      "internal": true
    },
    {
      "id": "remote-server.disconnect",
      "label": "Remote Server: Disconnect"
    },
    {
      "id": "remote-server.status",
      "label": "Remote Server: Connection Status"
    },
    {
      "id": "remote-server.connectToProcess",
      "internal": true
    },
    {
      "id": "remote-server.request",
      "internal": true
    },
    {
      "id": "remote-server.releaseWorkspace",
      "internal": true
    },
    {
      "id": "remote-server.cloudflare",
      "label": "Remote Server: Manage Tunnel Access"
    },
    {
      "id": "remote-server.prepareWorkspace",
      "internal": true
    },
    {
      "id": "remote-server.benchmark",
      "label": "Remote Server: Benchmark Connection"
    },
    {
      "id": "remote-server.connectAccount",
      "label": "Remote Server: Connect from LVCE Account"
    },
    {
      "id": "remote-server.disconnectAccount",
      "internal": true
    },
    {
      "id": "remote-server.getMachines",
      "internal": true
    },
    {
      "id": "remote-server.authorizeBrowser",
      "internal": true
    },
    {
      "id": "remote-server.accountWillChange",
      "internal": true
    },
    {
      "id": "remote-server.accountDidChange",
      "internal": true
    },
    {
      "id": "remote-server.reopenInContainer",
      "internal": true
    },
    {
      "id": "remote-server.reopenOnHost",
      "label": "Dev Containers: Reopen on Remote Host"
    }
  ],
  "fileSystemProviders": [
    {
      "id": "remote-server"
    },
    {
      "id": "remote-benchmark"
    }
  ],
  "workspaceTransport": {
    "scheme": "remote-server",
    "command": "remote-server.connectToProcess",
    "requestCommand": "remote-server.request"
  },
  "accountLifecycle": {
    "willChange": "remote-server.accountWillChange",
    "didChange": "remote-server.accountDidChange"
  }
}
