{
  "name": "builtin.remote-ssh-monorepo",
  "version": "0.0.0-dev",
  "description": "Remote SSH extension monorepo for Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:extension": "node packages/build/src/build-extension.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "npm run build:extension && npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/api": "^9.25.0",
    "@lvce-editor/eslint-config": "^18.7.1",
    "@lvce-editor/server": "^0.112.12",
    "@types/node": "^26.0.1",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "prettier": "^4.0.0-alpha.10",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
